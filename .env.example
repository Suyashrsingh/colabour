# Sahaay — Environment Variables Template
# Copy this file to `.env` in the project root (next to package.json) and fill in real values.
# NEVER commit your real .env file to Git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Optional Analytics (leave blank if not using) ─────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
